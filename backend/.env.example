# ==============================================================================
# Satellite-Based El Niño Heat Monitoring System - Backend Environment Config
# ==============================================================================
# Instructions:
# 1. Copy this file to backend/.env
# 2. Fill in your genuine API keys and credentials
# 3. NEVER commit your real .env file or credentials to source control / git
# ==============================================================================

# OpenWeatherMap API Key (Used for live temperature, humidity, wind & rainfall)
# Register at https://openweathermap.org/api to obtain a free API key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key (Optional: Used for AI Climate Research Assistant)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Heat Alert & Emergency Notification System)
# ------------------------------------------------------------------------------
# You can deliver real heat alerts via either:
# OPTION A (Recommended for campus Wi-Fi & mobile data): Brevo HTTPS REST API (Port 443)
#   - Register free at https://www.brevo.com/ (300 free emails/day to any inbox)
#   - Generate API key at Brevo -> Settings -> SMTP & API -> API Keys
#   - Port 443 is NEVER blocked by college firewalls or mobile cellular networks.
BREVO_API_KEY=your_brevo_api_key_here

# OPTION B: Central SMTP Server (Port 587 STARTTLS or Port 465 SSL)
#   - For Gmail: Use smtp.gmail.com with a 16-character Google App Password
#   - Note: Some campus/mobile networks block outbound SMTP ports 25, 465, 587.
# SMTP Server hostname (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP Account Username (Usually your full email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP Account Password
# For Gmail: Generate a 16-character App Password via Google Account -> Security -> 2-Step Verification -> App Passwords
# DO NOT use your regular personal Google account password!
SMTP_PASSWORD=your_16_character_app_password

# From Email Address displayed in outgoing heat alert emails
ALERT_FROM_EMAIL=your_email@gmail.com
# Alternatively, SMTP_FROM_EMAIL can also be used
SMTP_FROM_EMAIL=your_email@gmail.com

# Display Name for outgoing alerts
SMTP_FROM_NAME=Smart El Niño Heat Monitoring System

# Security mode: set to true or false to force STARTTLS or SSL
# (Defaults: TLS enabled for port 587; SSL enabled for port 465)
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Cooldown duration in minutes to prevent duplicate alert emails for the same risk state
ALERT_COOLDOWN_MINUTES=60

