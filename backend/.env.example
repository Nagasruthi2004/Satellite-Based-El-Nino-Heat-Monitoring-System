# ==============================================================================
# Satellite-Based El Niño Heat Monitoring System - Backend Environment Config
# ==============================================================================
# Instructions:
# 1. Copy this file to backend/.env
# 2. Fill in your genuine API keys and credentials
# 3. NEVER commit your real .env file or credentials to source control / git
# ==============================================================================

# OpenWeatherMap API Key (Used for live temperature, humidity, wind & rainfall)
# Register at https://openweathermap.org/api to obtain a free API key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key (Optional: Used for AI Climate Research Assistant)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# SMTP Configuration for Heat Alert & Notification System
# ------------------------------------------------------------------------------
# Note: If SMTP credentials are not configured, the application runs normally
# and the UI displays: "Email service is not configured."

# SMTP Server hostname (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP Account Username (Usually your full email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP Account Password
# For Gmail: Generate a 16-character App Password via Google Account -> Security -> 2-Step Verification -> App Passwords
# DO NOT use your regular personal Google account password!
SMTP_PASSWORD=your_16_character_app_password

# From Email Address displayed in outgoing heat alert emails
ALERT_FROM_EMAIL=your_email@gmail.com
